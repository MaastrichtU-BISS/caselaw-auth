{
  "version": "0.6.6",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./vue/style.css": "./dist/style.css",
    "./cli": "./bin/biss-auth.mjs",
    "./admin/*.mjs": "./admin/*.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "name": "biss-auth",
  "description": "Shared BISS OIDC authentication for browser, server, Svelte and Vue applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaastrichtU-BISS/caselaw-auth.git",
    "directory": "packages/biss-auth"
  },
  "homepage": "https://github.com/MaastrichtU-BISS/caselaw-auth#readme",
  "license": "MIT",
  "files": [
    "admin",
    "bin",
    "dist"
  ],
  "bin": {
    "biss-auth": "bin/biss-auth.mjs"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "svelte": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.8"
  },
  "bugs": {
    "url": "https://github.com/MaastrichtU-BISS/caselaw-auth/issues"
  }
}
