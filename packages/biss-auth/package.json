{
  "version": "0.6.5",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./vue/style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "name": "biss-auth",
  "description": "Shared BISS OIDC authentication for browser, server, Svelte and Vue applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaastrichtU-BISS/caselaw-auth.git",
    "directory": "packages/biss-auth"
  },
  "homepage": "https://github.com/MaastrichtU-BISS/caselaw-auth#readme",
  "license": "MIT",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "biss-auth": "bin/biss-auth.mjs"
  },
  "dependencies": {
    "caselaw-auth": "0.6.5"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-biss-auth.mjs"
  }
}
