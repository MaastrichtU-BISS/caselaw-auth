{
  "name": "caselaw-auth",
  "version": "0.6.6",
  "description": "Compatibility entry points for the standalone BISS Auth SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaastrichtU-BISS/caselaw-auth.git",
    "directory": "packages/caselaw-auth"
  },
  "homepage": "https://github.com/MaastrichtU-BISS/caselaw-auth#readme",
  "bugs": {
    "url": "https://github.com/MaastrichtU-BISS/caselaw-auth/issues"
  },
  "type": "module",
  "files": [
    "admin",
    "bin",
    "dist"
  ],
  "bin": {
    "caselaw-auth": "bin/caselaw-auth.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./vue/style.css": "./dist/style.css"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-legacy-auth.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "biss-auth": "0.6.6"
  }
}
