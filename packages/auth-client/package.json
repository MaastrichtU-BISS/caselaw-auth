{
  "name": "@caselaw/auth-client",
  "version": "0.1.0",
  "description": "Framework-neutral OIDC auth client for Case Law Explorer projects.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/caselaw-auth-client.cjs",
  "module": "./dist/caselaw-auth-client.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/caselaw-auth-client.js",
      "require": "./dist/caselaw-auth-client.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.5"
  }
}
