{
  "name": "@caselaw/auth-vue",
  "version": "0.1.0",
  "description": "Reusable Vue and Nuxt OIDC auth package for Case Law Explorer projects.",
  "type": "module",
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/caselaw-auth-vue.cjs",
  "module": "./dist/caselaw-auth-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/caselaw-auth-vue.js",
      "require": "./dist/caselaw-auth-vue.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@caselaw/auth-client": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.5.0",
    "vite": "^8.1.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.8"
  }
}
