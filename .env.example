# Versions
KEYCLOAK_VERSION=26.7.0
MAGIC_LINK_VERSION=0.75

# Keycloak admin account. It bootstraps the admin console and lets the
# container reconcile the existing realm through Keycloak's loopback API.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Optional passwordless mode. Username/email and password stays the default.
# Set CASELAW_PASSWORDLESS_AUTO_APPLY=true only after configuring and testing SMTP.
KEYCLOAK_REALM=caselaw
KEYCLOAK_ADMIN_REALM=master
CASELAW_PASSWORDLESS_AUTO_APPLY=false
# true reconciles Case Law estate clients; false installs only the generic realm flow.
# When unset, this defaults to true only for KEYCLOAK_REALM=caselaw.
CASELAW_PASSWORDLESS_ESTATE_MODE=
CASELAW_PASSWORDLESS_APPLY_TIMEOUT_SECONDS=180

# Canonical default public URL assigned in Coolify (use a full HTTPS URL).
# Each realm can override this with its Frontend URL; do not replace the
# global hostname when adding another project. See docs/PROJECT_AUTH_DOMAINS.md.
KEYCLOAK_HOSTNAME=
KEYCLOAK_HOSTNAME_STRICT=false
# Defaults to KEYCLOAK_HOSTNAME. Set a separate full HTTPS URL only after routing
# and TLS exist for it. One shared admin origin serves every project realm.
KEYCLOAK_ADMIN_HOSTNAME=

# Keycloak metadata database
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=

# Optional logging
KC_LOG_LEVEL=info

# Optional login page footer links
CASELAW_AUTH_FOOTER_MANAGED_BY=Authentication managed by BISS Institute
CASELAW_AUTH_FOOTER_BISS_LABEL=BISS Institute
CASELAW_AUTH_FOOTER_BISS_URL=https://www.maastrichtuniversity.nl/research/brightlands-institute-smart-society
CASELAW_AUTH_FOOTER_LAW_TECH_LABEL=Maastricht University Law & Tech Lab
CASELAW_AUTH_FOOTER_LAW_TECH_URL=https://www.maastrichtuniversity.nl/research/law-and-tech-lab
CASELAW_AUTH_FOOTER_API_LABEL=Citations API
CASELAW_AUTH_FOOTER_API_URL=https://demo-api.caselawexplorer.tech
