{
  "realm": "caselaw",
  "displayName": "Case Law Explorer",
  "enabled": true,
  "loginTheme": "caselaw",
  "accountTheme": "caselaw",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrative access to Case Law Explorer tools."
      },
      {
        "name": "researcher",
        "description": "Authenticated researcher access."
      },
      {
        "name": "service_consumer",
        "description": "Machine or external service consumer."
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "caselaw-browser-passwordless-email-first",
      "description": "Browser SSO with email OTP and single-use magic-link sign-in.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "Case Law email-first forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "Case Law email-first forms",
      "description": "Collect an email address, then let the user authenticate with a code or a link.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "caselaw-email-identity",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 20,
          "flowAlias": "Case Law email-first methods",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "Case Law email-first methods",
      "description": "Alternative passwordless methods available after the user supplies an email address.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "caselaw-email-first-otp",
          "authenticator": "ext-email-otp",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorConfig": "caselaw-email-first-magic-link",
          "authenticator": "ext-magic-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "caselaw-email-first-otp",
      "config": {
        "ext-magic-create-nonexistent-user": "false"
      }
    },
    {
      "alias": "caselaw-email-first-magic-link",
      "config": {
        "ext-magic-create-nonexistent-user": "false",
        "ext-magic-update-profile-action": "false",
        "ext-magic-update-password-action": "false",
        "ext-magic-allow-token-reuse": "false",
        "ext-magic-token-life-span": "600"
      }
    }
  ],
  "browserFlow": "browser",
  "clients": [
    {
      "clientId": "caselaw-frontend",
      "name": "Case Law Explorer Frontend",
      "description": "Browser application for Case Law Explorer.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "https://app.caselawexplorer.tech/*",
        "https://demo-app.caselawexplorer.tech/*",
        "https://frontend-*.sslip.io/*"
      ],
      "webOrigins": [
        "https://app.caselawexplorer.tech",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "caselaw-db-workbench",
      "name": "Case Law Explorer DB Workbench",
      "description": "SQL runner UI and database workbench.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5174/*",
        "https://demo-db.caselawexplorer.tech/*"
      ],
      "webOrigins": [
        "https://demo-db.caselawexplorer.tech",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "caselaw-api",
      "name": "Case Law Explorer API",
      "description": "Machine client for backend-to-backend calls. It never signs a person in.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "citations-api",
      "name": "Citations API documentation",
      "description": "Public browser client for the Citations API documentation and account UI.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "https://demo-api.caselawexplorer.tech/auth/callback",
        "https://api.caselawexplorer.tech/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://demo-api.caselawexplorer.tech",
        "https://api.caselawexplorer.tech"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "caselaw-access",
      "name": "Caselaw Access console",
      "description": "Browser application for Case Law Explorer.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://access.caselawexplorer.tech/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "https://access.caselawexplorer.tech",
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 1,
  "accessCodeLifespanLogin": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and passwordHistory(3)",
  "sslRequired": "external"
}
